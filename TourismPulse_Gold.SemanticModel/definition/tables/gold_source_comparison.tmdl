table gold_source_comparison
    column 'country_key'
        dataType: text
        isKey
        sourceColumn: country_key
    column 'country_name'
        dataType: text
        sourceColumn: country_name
    column 'world_bank_arrivals'
        dataType: text
        sourceColumn: world_bank_arrivals
    column 'world_bank_rows'
        dataType: text
        sourceColumn: world_bank_rows
    column 'un_arrivals'
        dataType: text
        sourceColumn: un_arrivals
    column 'un_rows'
        dataType: text
        sourceColumn: un_rows
    column 'estat_arrivals'
        dataType: text
        sourceColumn: estat_arrivals
    column 'estat_rows'
        dataType: text
        sourceColumn: estat_rows
    column 'discrepancy'
        dataType: text
        sourceColumn: discrepancy
