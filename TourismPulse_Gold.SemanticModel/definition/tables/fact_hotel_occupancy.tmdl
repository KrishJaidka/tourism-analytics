table fact_hotel_occupancy
    column 'country_key'
        dataType: text
        isKey
        sourceColumn: country_key
    column 'geo_code'
        dataType: text
        sourceColumn: geo_code
    column 'year'
        dataType: text
        sourceColumn: year
    column 'month'
        dataType: text
        sourceColumn: month
    column 'date_key'
        dataType: text
        sourceColumn: date_key
    column 'accommodation_unit'
        dataType: text
        sourceColumn: accommodation_unit
    column 'occupancy_rate'
        dataType: text
        sourceColumn: occupancy_rate
    column 'unit'
        dataType: text
        sourceColumn: unit
    column 'source_system'
        dataType: text
        sourceColumn: source_system
    column 'observation_status'
        dataType: text
        isHidden
        sourceColumn: observation_status
    column 'is_primary_period'
        dataType: text
        isHidden
        sourceColumn: is_primary_period
    measure 'Average Occupancy Rate' = AVERAGEX(fact_hotel_occupancy, occupancy_rate)
        formatString: $ #,##0.00
