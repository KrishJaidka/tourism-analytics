table fact_hotel_performance
    column 'country_key'
        dataType: text
        isKey
        sourceColumn: country_key
    column 'geo_code'
        dataType: text
        sourceColumn: geo_code
    column 'year'
        dataType: text
        sourceColumn: year
    column 'month'
        dataType: text
        sourceColumn: month
    column 'date_key'
        dataType: text
        sourceColumn: date_key
    column 'source_system'
        dataType: text
        sourceColumn: source_system
    column 'indicator_code'
        dataType: text
        sourceColumn: indicator_code
    column 'indicator_label'
        dataType: text
        sourceColumn: indicator_label
    column 'accommodation_metric'
        dataType: text
        sourceColumn: accommodation_metric
    column 'original_value'
        dataType: text
        isHidden
        sourceColumn: original_value
    column 'original_unit'
        dataType: text
        isHidden
        sourceColumn: original_unit
    column 'standardized_value'
        dataType: text
        sourceColumn: standardized_value
    column 'standardized_unit'
        dataType: text
        isHidden
        sourceColumn: standardized_unit
    column 'observation_status'
        dataType: text
        isHidden
        sourceColumn: observation_status
    column 'is_primary_period'
        dataType: text
        isHidden
        sourceColumn: is_primary_period
    measure 'Hotel Establishments' = SUMX(FILTER(fact_hotel_performance, accommodation_metric = "Establishments"), standardized_value)
        formatString: $ #,##0.00
    measure 'Hotel Rooms' = SUMX(FILTER(fact_hotel_performance, accommodation_metric = "Rooms"), standardized_value)
        formatString: $ #,##0.00
    measure 'Bed Places' = SUMX(FILTER(fact_hotel_performance, accommodation_metric = "Bed places"), standardized_value)
        formatString: $ #,##0.00
